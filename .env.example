# FebBox Addon environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# REQUIRED. Server-side secret used to encrypt/decrypt opaque per-user
# config tokens (which embed each user's FebBox `ui` token). Must be a
# long random string (>=32 chars recommended). The server refuses to start
# without this set to something >=16 chars — see src/app/index.js.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_SECRET=

# Optional but recommended. Used only for the official, documented TMDB
# `find` endpoint (IMDb -> TMDB id conversion). Get a free key at
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Port for the Express server (src/app/server.js).
PORT=7000

# Optional. Enables the admin dashboard at /admin (password login) showing every
# install, its tokens' quota status and usage. If unset the dashboard is disabled.
# Use a long random value and serve over HTTPS only.
ADMIN_PASSWORD=

# Optional. Where the install registry (registry.json) is stored. Default: ./data
# On Docker, mount a volume here to keep it across restarts.
DATA_DIR=

# Optional, default 1024. With several tokens, a token with less remaining
# quota than this (in MB) is treated as "low" and only used if no other token
# has more room.
MIN_REMAINING_MB=1024
